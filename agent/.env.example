# The deployed GHOSTWORK contract (same as contract_id in deployment.yaml)
AGENT_CONTRACT_ID=
# NEAR account that funds the agent's own account (create with: shade auth set near testnet create-new)
SPONSOR_ACCOUNT_ID=
SPONSOR_PRIVATE_KEY=
# NEAR AI Cloud key for private inference (https://cloud.near.ai -> API Keys)
NEAR_AI_API_KEY=
# Optional: any OpenAI-compatible endpoint and model
# LLM_BASE_URL=https://cloud-api.near.ai/v1
# LLM_MODEL=Qwen/Qwen3.8-27B
# Development only: answer with a placeholder instead of calling a model
# LLM_MODE=mock
